# Copy this file to ".env" for local development (optional - defaults work).
# On Render, add these in the service's Environment tab instead.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty to use local SQLite (db.sqlite3).
# For PostgreSQL (Render or Neon) use e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Administrator account created by `python manage.py ensure_admin`
ADMIN_USERNAME=clinicadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
